{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Throughline desktop capability set",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$APPDATA/throughline/**" },
        { "path": "$APPDATA/Throughline/**" },
        { "path": "$DOCUMENT/Throughline/**" },
        { "path": "$HOME/Documents/Throughline/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$APPDATA/throughline/**" },
        { "path": "$APPDATA/Throughline/**" },
        { "path": "$DOCUMENT/Throughline/**" },
        { "path": "$HOME/Documents/Throughline/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$APPDATA/throughline/**" },
        { "path": "$APPDATA/Throughline/**" },
        { "path": "$DOCUMENT/Throughline/**" },
        { "path": "$HOME/Documents/Throughline/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$APPDATA/throughline/**" },
        { "path": "$APPDATA/Throughline/**" },
        { "path": "$DOCUMENT/Throughline/**" },
        { "path": "$HOME/Documents/Throughline/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$APPDATA/throughline/**" },
        { "path": "$APPDATA/Throughline/**" },
        { "path": "$DOCUMENT/Throughline/**" },
        { "path": "$HOME/Documents/Throughline/**" }
      ]
    }
  ]
}
